# WHERE IS MY TRAIN - Backend Environment Variables

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (PostgreSQL)
# e.g., postgresql://postgres:password@localhost:5432/whereismytrain?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whereismytrain?schema=public

# Railway Data Provider Configuration
# Options: "mock", "ntes", "licensed", "fallback"
DEFAULT_DATA_PROVIDER=mock
ENABLE_PROVIDER_FALLBACK=true
CACHE_TTL_SECONDS=60

# Official NTES / CRIS Gateway Configuration (when authorized)
NTES_API_BASE_URL=https://api.indianrail.gov.in
NTES_API_KEY=your_cris_or_ntes_auth_key_here

# Licensed Railway Data Partner Provider (when authorized)
LICENSED_PROVIDER_BASE_URL=https://partner.railwayapi.example.com
LICENSED_PROVIDER_API_KEY=your_licensed_api_key_here

# Security
# JWT_SECRET and ADMIN_API_KEY MUST be set to long random values for production deployments.
# The admin API fails safely (503) when ADMIN_API_KEY is missing — no default/fallback secret exists.
JWT_SECRET=
ADMIN_API_KEY=

# --- Prisma query engine (only needed on Windows-on-ARM) ---------------------
# Prisma ships no native windows-arm64 query engine, so the default x64
# query_engine-*.dll.node cannot be loaded by arm64 Node (Win32 error 193,
# ERROR_BAD_EXE_FORMAT / "is not a valid Win32 application").
# Uncomment the line below on such machines: Prisma will spawn the x64
# query-engine-*.exe instead, which runs under Windows x64 emulation.
# Leave it commented out on Linux/macOS/x64 (including Vercel) to keep the
# default library engine.
# PRISMA_CLIENT_ENGINE_TYPE=binary
