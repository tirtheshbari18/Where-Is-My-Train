PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Primary provider code: 'mock' | 'external' | 'licensed' | 'ntes'
PRIMARY_RAILWAY_PROVIDER=mock
SECONDARY_RAILWAY_PROVIDER=external
ENABLE_PROVIDER_FALLBACK=true

# External Authorized Railway API Gateway
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=
RAILWAY_API_HOST=
RAILWAY_API_TIMEOUT_MS=10000
RAILWAY_CACHE_TTL_SECONDS=30
RAILWAY_LIVE_REFRESH_SECONDS=30

# Legacy compatibility keys
DEFAULT_DATA_PROVIDER=mock
CACHE_TTL_SECONDS=60
NTES_API_BASE_URL=https://api.indianrail.gov.in
NTES_API_KEY=
LICENSED_PROVIDER_BASE_URL=
LICENSED_PROVIDER_API_KEY=

# Security
JWT_SECRET=super_secret_railway_jwt_key_change_in_production
ADMIN_API_KEY=wimt_admin_secret_key_2026

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whereismytrain?schema=public
PRISMA_CLIENT_ENGINE_TYPE=binary
