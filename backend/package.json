{
  "name": "where-is-my-train-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Indian Railway Data Provider & Live Tracking Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/db/seed.ts",
    "import:zones": "tsx scripts/importZones.ts",
    "import:divisions": "tsx scripts/importDivisions.ts",
    "import:stations": "tsx scripts/importStations.ts",
    "import:trains": "tsx scripts/importTrains.ts",
    "import:train-stops": "tsx scripts/importTrainStops.ts",
    "import:platforms": "tsx scripts/importPlatforms.ts",
    "import:routes": "tsx scripts/importRoutes.ts",
    "validate:railway-data": "tsx scripts/validateRailwayData.ts",
    "rebuild:search-index": "tsx scripts/rebuildSearchIndex.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
