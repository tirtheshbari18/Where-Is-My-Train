# Root Environment Configuration Template
# Copy this file to .env locally, or declare these in your deployment dashboard
# (Vercel -> Project -> Settings -> Environment Variables) for Production/Preview.
#
# The root project deploys to Vercel as ONE project:
#   - build:  `npm run install:all` then `npm run build` (backend tsc + frontend vite)
#   - serve:  frontend/dist, with /api/* rewritten to the `api/index.js` function
#             which loads the compiled backend from backend/dist/index.js

# Application Environment
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------
# Frontend (Vite) - inlined at BUILD time, must be prefixed with VITE_
# ------------------------------------------------------------------
# Base URL the browser uses for every railway request. Leave as /api when the
# API is served by the same deployment (the default rewrites). Set an absolute
# URL such as https://my-api.example.com/api when the API is hosted elsewhere.
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------
# Backend runtime
# ------------------------------------------------------------------
# Railway Data Provider Mode ('mock' | 'licensed' | 'ntes')
DEFAULT_DATA_PROVIDER=mock
ENABLE_PROVIDER_FALLBACK=true
CACHE_TTL_SECONDS=60

# Security - generate long random values for production.
# ADMIN_API_KEY guards /api/admin/* (fails safely with 503 when unset).
JWT_SECRET=
ADMIN_API_KEY=

# Database Connection (PostgreSQL with Prisma - optional when using the mock provider)
DATABASE_URL=postgresql://user:password@localhost:5432/where_is_my_train?schema=public

# Optional External API Keys (Leave blank to use robust built-in simulated providers)
NTES_API_BASE_URL=https://api.indianrail.gov.in
NTES_API_KEY=
LICENSED_PROVIDER_BASE_URL=
LICENSED_PROVIDER_API_KEY=
# GOOGLE_MAPS_API_KEY=
# RAPIDAPI_IRCTC_KEY=
# CRIS_API_TOKEN=
# BEST_BUS_API_KEY=
