# Root Environment Configuration Template
# Copy this file to .env or configure in your deployment dashboard (e.g. Vercel / Railway / Render)

# Application Environment
NODE_ENV=production
PORT=5000

# Backend URL for Frontend Client (Leave empty if using same-origin or reverse-proxy)
VITE_API_BASE_URL=/api

# Railway Data Provider Mode ('mock' | 'licensed' | 'ntes')
RAILWAY_DATA_PROVIDER=mock

# Database Connection (PostgreSQL with Prisma - optional if running mock provider)
DATABASE_URL=postgresql://user:password@localhost:5432/where_is_my_train?schema=public

# Optional External API Keys (Leave blank to use robust built-in simulated providers)
# GOOGLE_MAPS_API_KEY=
# RAPIDAPI_IRCTC_KEY=
# CRIS_API_TOKEN=
# BEST_BUS_API_KEY=
